# =============================================================================
# AI Doctor Follow-Up Agent — repository ignore rules (Phase 1)
# =============================================================================
# Rule of thumb: anything generated locally (dependencies, virtualenvs, runtime
# databases, logs, caches, model weights, uploads) is ignored; only source,
# contract documents and synthetic fixtures are tracked.
# Requirement: REQ-SEC-06 — "No secrets, .env, runtime DBs, uploads, or model
# weights are committed."
# =============================================================================

# --- environment and secrets -------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials*
.npmrc
.pypirc
.netrc

# --- python virtual environments (kept on E: by setup.ps1) -------------------
.venv/
venv/
env/
ENV/
*.egg-info/
.eggs/
build/
dist/
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- python tooling caches ---------------------------------------------------
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
.coverage.*
coverage.xml
htmlcov/
.benchmarks/

# --- node / frontend --------------------------------------------------------
node_modules/
.vite/
dist/
dist-ssr/
coverage/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- test and browser artefacts ---------------------------------------------
playwright-report/
test-results/
blob-report/
.playwright/
test-artifacts/
*.trace.zip

# --- runtime data (synthetic fixtures stay tracked; runtime never does) -----
data/runtime/
**/runtime/
uploads/
**/uploads/
*.sqlite
*.sqlite3
*.db
*.db-wal
*.db-shm
*.db-journal
*.log
logs/
*.pid
*.run.json

# --- model artefacts --------------------------------------------------------
models/
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.onnx
.cache/
ollama/

# --- OS / editor ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
