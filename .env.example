# =============================================================================
# AI Doctor Follow-Up Agent — local configuration template
# EDUCATIONAL / SYNTHETIC DATA / NOT FOR CLINICAL USE
# =============================================================================
#
# HOW TO USE
#   1. Copy this file to `.env` in the repository root:
#        PowerShell:  Copy-Item .env.example .env
#   2. Edit only what you need. Every value below has a safe local default.
#   3. Never commit `.env` — it is gitignored. Never put a real credential,
#      token or patient value in it: this project is synthetic-data only.
#
# `setup.ps1` creates `.env` from this template on first run if it is missing.
# =============================================================================

# --- application -------------------------------------------------------------
# local | ci | test
APP_ENV=local
# Loopback only. Do not bind 0.0.0.0: the demo is single-machine (ADR-0003).
APP_HOST=127.0.0.1
APP_PORT=8000
# critical | error | warning | info | debug
LOG_LEVEL=info

# Build SHA reported by GET /version. Leave empty for automatic detection via
# `git rev-parse HEAD`. CI sets it explicitly. 7-40 hexadecimal characters.
APP_GIT_SHA=

# --- database ----------------------------------------------------------------
# SQLAlchemy URL. A relative SQLite path is resolved against the repository
# root, so the scripts, pytest and Alembic always agree.
# The file lives under the gitignored data/runtime/ directory.
DATABASE_URL=sqlite:///data/runtime/app.db

# Alembic-only override (optional). When empty, Alembic uses DATABASE_URL.
# ALEMBIC_DATABASE_URL=

# --- patient domain / authentication (P2) ------------------------------------
# Bearer session lifetime in minutes. A session older than this is rejected with
# the uniform 401, exactly like an unknown token.
SESSION_TTL_MINUTES=60

# Failed-login budget per username and the rolling window it applies to. The
# (n+1)-th failure inside the window returns `429 E_RATE_LIMITED`. In-process
# only: restarting the API clears the counter (documented MVP limitation).
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# Enables `POST /api/v1/demo/reset`. Deliberately OFF by default so the
# destructive demo operation is never reachable by accident. With it off the
# endpoint answers `403 E_DEMO_MODE_REQUIRED`.
DEMO_MODE=false

# Local-only password for the synthetic demo accounts. There is NO default and
# none is committed: the bootstrap refuses to run without it.
#
# First run on a fresh database (schema comes from Alembic, never from the CLI):
#   1. alembic -c backend/migrations/alembic.ini upgrade head
#   2. set DEMO_MODE=true and DEMO_SEED_PASSWORD=<a local throwaway secret> here
#      (PowerShell:  $env:DEMO_MODE='true'; $env:DEMO_SEED_PASSWORD='...')
#   3. python -m app.services.seed          (module path: backend/app)
# Only a salted PBKDF2-SHA256 hash is stored; the password is never printed,
# logged, committed or returned by any endpoint.
DEMO_SEED_PASSWORD=

# No `POST /demo/seed` endpoint exists in any phase, and `GET /demo/status` is
# deferred to P5 (OQ-P2-01): it would have to report a drafting provider that
# does not exist yet.

# --- Phase 3: document ingestion and extraction ------------------------------
# All optional. The defaults mirror EXTRACTION_PROVENANCE.md §1-§2 exactly, so an
# unset environment behaves identically to the documented contract.
#
# Local OCR engine path (ASM-01). Unset means "not configured": OCR is reported
# unavailable and a scanned document ends `failed` with E_DEPENDENCY_MISSING.
# That is an honest state, not an error — the text-layer path still works.
#   Windows example: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
#TESSERACT_CMD=
#
# OCR language. Only `eng` is supported in the MVP; another value is a config
# error rather than a silent fallback.
#OCR_LANGUAGE=eng
#
# App DB holds only what P3 actually stores: filenames under data/runtime/uploads.
# Leave unset in the repository; tests always point this at a temporary directory.
#UPLOAD_DIR=
#
# Resource bounds (REQ-ING-01/05). Changing these changes what the API accepts,
# so they are configuration rather than contract constants.
#MAX_UPLOAD_BYTES=10485760
#MAX_PDF_PAGES=20
#MAX_IMAGE_PIXELS=40000000
#TEXT_LAYER_MIN_CHARS=40
#MAX_EXTRACTED_FACTS=40
#EXTRACTION_TIMEOUT_SECONDS=20
#
# DEMO_ONLY mechanics, not clinical or accuracy claims (DEMO_REVIEW_RULES.md §9).
#OCR_CONFIDENCE_FLOOR=0.70
#CONFLICT_TOLERANCE=0.0

# --- reserved for later phases (NOT read by P3 code) -------------------------
# No drafting provider exists yet, so `/health` truthfully reports `ollama` as
# `not_configured`.
#
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=
